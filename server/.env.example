# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peoplecore

# Microsoft Entra ID (Azure AD) Authentication
# tenantId and clientId are required for token verification
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID

# Toggle token verification for local development/testing
# Set to false to bypass Entra ID signature verification and use headers
VALIDATE_AZURE_TOKEN=false

# Google Gemini API Key for narrative insights (Optional)
GEMINI_API_KEY=
