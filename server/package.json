{
  "name": "peoplecore-backend",
  "version": "1.0.0",
  "description": "TypeScript Express Backend for PeopleCore HR Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon -L --watch src -e ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "ts-node src/scripts/db-init.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "express",
    "typescript",
    "mysql",
    "msal",
    "hr"
