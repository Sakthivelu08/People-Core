FROM node:18-alpine

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies (including devDependencies for local CLI compile)
RUN npm install

# Copy source code files
COPY . .

# Expose dev server port
EXPOSE 80

# Run in watch mode with active file polling
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "80", "--poll", "2000"]
